# Copy to .env and change the values.
CE_DATABASE_URL=postgresql+psycopg://app_user:app_password@localhost:5432/compliance
# At least 32 random characters, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(48))"
CE_JWT_SECRET=change-me-change-me-change-me-change-me
CE_ACCESS_TOKEN_MINUTES=60
CE_FACTORY_TIMEZONE=Asia/Riyadh
# Language of texts the system writes into records (deviation descriptions, alerts): ar or en
CE_RECORD_LANGUAGE=ar
# How often (seconds) the server looks for overdue CCP checks; 0 turns it off.
CE_ALERT_SCAN_SECONDS=300
# Wrong passwords in a row (login, signature, password change) before an account locks.
CE_MAX_FAILED_PASSWORDS=5
# Days a corrective action may stay open before the dashboard counts it as overdue.
CE_CAPA_TARGET_DAYS=7

# --- Alert notifications (optional) ---
# E-mail and WhatsApp can also be set on the app's notifications page; those settings win.
# They are encrypted with CE_JWT_SECRET, so keep that value unchanged once set.
# How often (seconds) queued alert messages are sent; 0 turns sending off.
CE_NOTIFY_SECONDS=30
# Link added to messages, e.g. http://192.168.1.20:8000
# CE_PUBLIC_URL=
# E-mail (SMTP). Gmail: smtp.gmail.com, 587, starttls, and an App Password.
# CE_SMTP_HOST=smtp.gmail.com
# CE_SMTP_PORT=587
# CE_SMTP_SECURITY=starttls
# CE_SMTP_USERNAME=qa.alerts@gmail.com
# CE_SMTP_PASSWORD=
# CE_SMTP_FROM=qa.alerts@gmail.com
# WhatsApp Business Cloud API (Meta).
# CE_WHATSAPP_TOKEN=
# CE_WHATSAPP_PHONE_NUMBER_ID=
# CE_WHATSAPP_TEMPLATE=quality_alert
# CE_WHATSAPP_TEMPLATE_LANGUAGE=ar
